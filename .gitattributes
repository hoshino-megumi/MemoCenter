# 统一换行符策略
# .bat 是 GBK + CRLF 的命令行脚本，禁止任何转换，保持字节原样
*.bat -text
*.cmd -text

# .vbs 是 UTF-16 LE (带 BOM) 的 WSH 脚本，同样禁止转换，
# 一旦被当作文本处理，编码与换行都会损坏，双击后静默失败
*.vbs -text

# shell 脚本统一 LF
*.sh text eol=lf

# 构建与配置文件按文本处理，仓库内统一 LF
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.mermaid text eol=lf

# 图片等二进制，禁止 diff 与转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary

# 无扩展名的仓库配置文件，单独声明以消除换行告警
/.gitignore    text eol=lf
/.gitattributes text eol=lf
