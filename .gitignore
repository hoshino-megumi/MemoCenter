# ============================================================================
# 备忘中心 · 推送到 GitHub 时需要排除的内容清单
# 生成时间：2026-11-24   适用仓库：https://github.com/hoshino-megumi/MemoCenter
#
# 用法：本文件是标准 .gitignore 语法，但【文件名必须是 .gitignore】，
#       带前缀（1.、备份. 等）Git 一律不读取，规则不会生效。
#
# 判断标准：能由命令重新生成的不提交；含个人数据的不提交；系统/编辑器产生的不提交。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. 第三方依赖 —— 411 MB，必排除
#    npm install 会按 package.json + package-lock.json 完整重建，
#    提交它只会让仓库暴涨、clone 极慢，且部分二进制与平台绑定。
# ---------------------------------------------------------------------------
node_modules/


# ---------------------------------------------------------------------------
# 2. 前端构建产物 —— 250 KB，必排除
#    npm run build 重新生成；提交后每次改代码都会产生大量无意义 diff。
#    注意：Electron 启动前会检查 dist/index.html，首次使用需自己构建一次。
# ---------------------------------------------------------------------------
dist/


# ---------------------------------------------------------------------------
# 3. 运行时数据 —— 必排除（这是隐私风险最高的一项）
#    含本机真实使用数据：
#      memos.json      待办事项（周报、台账、需求排期等实际工作内容）
#      notes.json      便签
#      history.jsonl   变更记录（含变更原因，可能涉及业务判断）
#      settings.json   本机设置与窗口位置
#      attachments/    截图佐证（常含内部系统界面、客户信息）
#      backups/        每日快照（同样含上述数据）
#      desktop.log     运行日志
#    公开仓库一旦推上去，等于把工作内容公开，且无法彻底撤回。
# ---------------------------------------------------------------------------
data/


# ---------------------------------------------------------------------------
# 4. 工具与本地缓存 —— 必排除
#    .workbuddy/  编辑器会话记忆、任务记录，属于本机工作过程，与项目无关
#    .tmp/        调试与截图用的临时目录
# ---------------------------------------------------------------------------
.workbuddy/
.tmp/


# ---------------------------------------------------------------------------
# 5. 日志文件
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ---------------------------------------------------------------------------
# 6. 编辑器与操作系统文件
#    这些是打开项目时自动生成的，不同机器各不相同，提交会持续制造冲突。
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.swp
.DS_Store
Thumbs.db
desktop.ini


# ---------------------------------------------------------------------------
# 7. 环境变量与密钥（目前没有，先占位，避免以后误提交）
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local


# ---------------------------------------------------------------------------
# 8. 打包产物（现在用源码运行，暂不涉及；将来做安装包时生效）
# ---------------------------------------------------------------------------
release/
out/
*.exe
*.msi


# ============================================================================
# 以下是【必须提交】的内容，不要加进忽略规则，仅作对照
# ----------------------------------------------------------------------------
#   package.json          依赖与脚本定义
#   package-lock.json      锁定版本，缺了它别人装出来的依赖可能不一致
#   src/                   前端源码（React）
#   server/                后端源码（Node 原生模块，零第三方依赖）
#   desktop/               Electron 主进程、启动器、托盘图标
#   index.html / focus.html / toast.html   三个页面入口
#   vite.config.js         构建配置
#   README.md              使用说明
#   start.bat / start.sh   网页端启动脚本
#   desktop.bat / desktop-debug.bat        桌面端启动脚本
#
#   ⚠ 三个 .bat 文件（start / desktop / desktop-debug）是 GBK 编码 + CRLF 换行，
#     属于命令行脚本，提交时务必关闭换行符自动转换，否则别人拉下来会满屏乱码。
#     已配置在 .gitattributes 中：*.bat -text、*.sh text eol=lf，
#     由该文件保证拉取后不转换换行符。
# ============================================================================


# ============================================================================
# 附：仓库状态与推送前自检（2026-11-24 已处理）
# ----------------------------------------------------------------------------
# ① 本文件已恢复为标准名 .gitignore，规则生效中。
# ② .workbuddy/ 已从版本库索引摘除（本地文件保留），
#    并由本文件的 .workbuddy/ 规则覆盖，不会再被跟踪。
#
# ③ 推送前自检，确认待提交清单里不含 node_modules / dist / data：
#        git add -A
#        git status --short
#    预期只应看到源码文件、.gitignore、.gitattributes，以及 .workbuddy 的删除记录。
#
# ④ 首次提交时 core.autocrlf=true（来源：可移植 Git 的 system 级 gitconfig）
#    已把 3 个 .bat 的 CRLF 压成 LF；本次加入 *.bat -text 后，
#    重新 add 会把这 3 个文件记为 M，属修复生效，正常提交即可。
# ============================================================================
